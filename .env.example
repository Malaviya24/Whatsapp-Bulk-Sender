# BulkSender Configuration Example
# Copy this file to .env and adjust values as needed
# (.env is auto-created on first run if it doesn't exist)

# ─── Server Settings ───
# Port to run the dashboard on
PORT=5000

# ─── Anti-Ban Settings ───
# Random delay between messages (in seconds)
# Higher values = safer but slower
DELAY_MIN=10
DELAY_MAX=25

# Batch settings (helps avoid WhatsApp ban)
# After every BATCH_SIZE messages, wait BATCH_COOLDOWN seconds
# Set BATCH_SIZE=0 to disable batching
BATCH_SIZE=25
BATCH_COOLDOWN=180

# ─── Advanced (Optional) ───
# Use system Chrome instead of bundled Chromium (faster but can be unstable)
# USE_SYSTEM_CHROME=true
